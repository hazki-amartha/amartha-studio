# Drafting Board — environment variables
# Copy to `.env.local` for local dev, or set these in your host's dashboard
# (Vercel: Project → Settings → Environment Variables). Never commit real values.

# Shared stakeholder password for the site-wide gate.
# When UNSET, the password gate is DISABLED (convenient for local dev / previews).
# Set this in every environment you want protected (Production is required).
SITE_PASSWORD=

# Optional extra secret mixed into the session-cookie signature.
# Rotating it (or changing SITE_PASSWORD) invalidates all existing sessions,
# forcing everyone to re-enter the password. Use a long random string, e.g.
#   openssl rand -hex 32
# Safe to leave blank — the password alone still produces a valid signing key.
SITE_SESSION_SECRET=

# Assets — base URL of the illustration generator deployment (repo:
# amartha-illustration), with no trailing slash and no /assets-app suffix.
# The studio proxies /assets-app/* to it and embeds it at /assets. Unset, the
# Assets section shows a "not connected" note. Local dev: http://localhost:3001
ASSET_GENERATOR_URL=

# Sign-in — Google via the Vocus Supabase project (platform/auth), shared with
# Vocus and the Assets app so one login covers the studio and /assets-app.
# Unset, sign-in is off: the rail shows no account button and saving from the
# link falls back to the editing password. Local dev doesn't need these — the
# laptop is the identity. Roles and owner names: supabase/migrations/20260924_studio_roles.sql.
# Supabase → Auth → URL Configuration must allow https://<studio domain>/**.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; reads the caller's own role row. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Members-only studio, as in Vocus. Set to 1 once share links have gone out:
# then everything needs an Amartha Google sign-in except a prototype opened
# through its share link (platform/share). Needs the Supabase keys above and
# the comment store (KV_* / UPSTASH_*), which also holds share links.
STUDIO_REQUIRE_SIGN_IN=
